{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/clouds.js": {
      "maxDuration": 120,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/clouds/:route+", "destination": "/api/clouds?route=:route" }
  ],
  "redirects": [
    { "source": "/", "destination": "/solar-system/", "permanent": false },
    { "source": "/solar-system", "destination": "/solar-system/", "permanent": false },
    { "source": "/black-hole", "destination": "/black-hole/", "permanent": false }
  ],
  "headers": [
    { "source": "/assets/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/shared/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }] },
    { "source": "/solar-system/textures/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }] }
  ]
}
